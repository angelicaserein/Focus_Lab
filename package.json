{
  "name": "todo-vite-react",
  "version": "1.0.0",
  "private": true,
  "description": "ADHD 专注实验室 —— 计时、陪伴、任务与数据洞察",
  "author": "Focus Lab",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "desktop:dev": "node scripts/dev-desktop.mjs",
    "desktop:pack": "vite build && electron-builder --dir",
    "desktop:build": "vite build && electron-builder",
    "journal": "node scripts/git-notion-logger/index.mjs",
    "shot": "node scripts/shot.mjs",
    "data:example": "node scripts/gen-example-data.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "prepare": "git config core.hooksPath .githooks || exit 0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.23.0",
    "openai": "^6.46.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-router-dom": "^6.30.4",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.9",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "playwright": "^1.60.0",
    "vite": "^5.0.0",
    "vitest": "^4.1.9"
  }
}
