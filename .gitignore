# Dependencies
node_modules/

# Build output
dist/

# Electron 打包产物（安装包 / 解包目录）
release/

# Test coverage report
coverage/

# Playwright（scripts/shot.mjs 用）跑出来的报告
playwright-report/
test-results/

# Vercel CLI 的本地链接信息
.vercel/

# 本地临时产物统一放这里：截图（.claude/skills/run-desktop、scripts/shot.mjs）、
# scripts/gen-example-data.mjs 生成的示例备份 json
.tmp/

# Logs
*.log
npm-debug.log*

# Environment / secrets
.env
.env.local
.env.*.local

# Editor / OS
.DS_Store
Thumbs.db
desktop.ini
.vscode/*
!.vscode/tasks.json
.idea/

# 本地待办 / 临时笔记（不进版本库）
待办/

# 论文草稿与编辑产生的临时 / 备份文件（不进版本库；研究稿件不入应用仓库）
paper/
*.bak
paper_change_summary.txt
paper_debug_excerpt.txt

